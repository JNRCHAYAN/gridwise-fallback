# Copy to .env and fill in real values. NEVER commit the filled-in file.
# The service reads these from the environment; .env is gitignored.

# --- Required -------------------------------------------------------------
# API key for the language model that interprets operator notes.
LLM_API_KEY=

# --- Optional (defaults shown) -------------------------------------------
# Base URL of the model provider. Default speaks the Anthropic Messages API.
LLM_BASE_URL=https://capi.aerolink.lat

# Model identifier used for operator-note interpretation.
LLM_MODEL=claude-haiku-4-5-20251001

# Wire format: "anthropic" (default) or "openai" (Ollama, vLLM, most others).
LLM_API_STYLE=anthropic

# --- Alternative provider: DeepSeek --------------------------------------
# DeepSeek speaks the OpenAI chat-completions shape, so only these three
# variables change — no code change is needed to switch providers.
#
#   LLM_API_KEY=<your deepseek key>
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#   LLM_API_STYLE=openai
#
# The same three-line swap works for a local Ollama server, with
# LLM_BASE_URL=http://localhost:11434 and LLM_MODEL set to a pulled tag.

# Per-request timeout for the model call, in seconds.
LLM_TIMEOUT_SECONDS=20

# Maximum tokens for the interpretation response.
LLM_MAX_TOKENS=1500

# Service settings.
PORT=8000
LOG_LEVEL=INFO
