# Copy to .env and fill in real values. NEVER commit the filled-in file.
# The service loads .env automatically at startup when the file is present, so
# the quickstart is: copy this file, set LLM_API_KEY, start the service.
#
# A variable already present in the real environment always wins over .env, so
# this file can never override a deployed container's configuration.

# --- Required -------------------------------------------------------------
# API key for the language model that interprets operator notes.
LLM_API_KEY=

# --- Model route (matches the submitted deployment) -----------------------
# These are NOT secrets. The service speaks either the OpenAI chat-completions
# shape or the Anthropic Messages shape; only these values change between
# providers, and no code edit is needed to switch.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_STYLE=openai

# --- Alternative: Anthropic-Messages-compatible provider (e.g. Aerolink) ---
#   LLM_BASE_URL=https://capi.aerolink.lat
#   LLM_MODEL=claude-haiku-4-5-20251001
#   LLM_API_STYLE=anthropic
#
# --- Alternative: local Ollama (no external provider, no cost) ------------
#   LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=llama3.1
#   LLM_API_STYLE=openai
#   LLM_API_KEY=ollama            # ignored by Ollama, but must be non-empty

# --- Tuning (defaults shown) ----------------------------------------------
# Per-request timeout for the model call, in seconds.
LLM_TIMEOUT_SECONDS=20

# Maximum tokens for the interpretation response.
LLM_MAX_TOKENS=1500

# --- Service --------------------------------------------------------------
# Listening port. Render and most PaaS providers inject this themselves.
PORT=8000
LOG_LEVEL=INFO
